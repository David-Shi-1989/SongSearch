#!/bin/bash
set -e

echo "🚀 Entering pre-commit notification script..."

source "$(dirname "$0")/ui.sh"

NOTIFICATION_CONFIG=".husky/pre-commit-notification/config.ini"
CACHE_FILE=".husky/pre-commit-notification/notification-counts.txt"
CURRENT_DATE=$(date +%Y-%m-%d)

# Parse date string to timestamp (cross-platform)
parse_date() {
  local date_str=$1
  if date -d "$date_str" "+%s" >/dev/null 2>&1; then
    date -d "$date_str" "+%s"
  else
    date -j -f "%Y-%m-%d" "$date_str" "+%s"
  fi
}

# Reset support
if [ "$1" = "--reset" ]; then
  echo "# pre-commit notification counter" > "$CACHE_FILE"
  echo "✅ Notification count reset."
  exit 0
fi

# Initialize count cache
if [ ! -f "$CACHE_FILE" ]; then
  echo "# pre-commit notification counter" > "$CACHE_FILE"
fi

SECTION_NAMES=$(grep "^\[" "$NOTIFICATION_CONFIG" | sed 's/\[//;s/\]//')

for section in $SECTION_NAMES; do
  content=$(sed -n "/^\[$section\]/,/^\[/p" "$NOTIFICATION_CONFIG" | grep -v "^\[" || true)

  start_date=$(echo "$content" | grep -E "^start=" | cut -d'=' -f2- | xargs)
  end_date=$(echo "$content" | grep -E "^end=" | cut -d'=' -f2- | xargs)
  text_cn=$(echo "$content" | grep -E "^text_cn=" | cut -d'=' -f2- | xargs)
  text_en=$(echo "$content" | grep -E "^text_en=" | cut -d'=' -f2- | xargs)
  max_count=$(echo "$content" | grep -E "^max=|^max_count=" | cut -d'=' -f2 | xargs)

  if [ -z "$start_date" ] || [ -z "$end_date" ]; then
    continue
  fi

  start_ts=$(parse_date "$start_date") || continue
  end_ts=$(parse_date "$end_date") || continue
  now_ts=$(date +%s)

  if [ "$now_ts" -ge "$start_ts" ] && [ "$now_ts" -le "$end_ts" ]; then
    current_count=$(grep "^\[$section\]=" "$CACHE_FILE" | cut -d'=' -f2)
    current_count=${current_count:-0}

    if [ -n "$max_count" ] && [ "$current_count" -ge "$max_count" ]; then
      continue
    fi

    PROMPT_MESSAGE=$(
      cat <<EOF
· English Notice
$text_en

· 中文提示
$text_cn

Please type 'confirm' to proceed with the commit.
EOF
    )

    user_input=$(show_prompt_dialog "$PROMPT_MESSAGE")

    if [ "$user_input" != "confirm" ]; then
      echo "🔴 Commit blocked. You must type 'confirm' to proceed."
      exit 1
    fi

    new_count=$((current_count + 1))
    if grep -q "^\[$section\]=" "$CACHE_FILE"; then
      sed -i "s/^\[$section\]=.*/\[$section\]=$new_count/" "$CACHE_FILE"
    else
      echo "[$section]=$new_count" >> "$CACHE_FILE"
    fi

    echo "✅ Commit confirmed and recorded."
  fi
done

exit 0
